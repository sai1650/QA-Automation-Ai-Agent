APP_NAME=Autonomous QA Intelligence Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_PROMPT_CHARS=16000

# Local historical QA retrieval. The embedding model must be available locally;
# application startup does not download model files.
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_CHUNKS_PER_DOCUMENT=100
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_DOCUMENT_CHARS=100000
RAG_MAX_CONTEXT_CHARS=6000
CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_COLLECTION_NAME=qa_historical_knowledge

# MySQL application database. Set DB_PASSWORD to the password for app_user.
DB_USER=app_user
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=AI_AGENT

LOG_LEVEL=INFO
ARTIFACT_DIR=../artifacts

BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_EXECUTION_TIMEOUT_MS=60000
BROWSER_MAX_ELEMENTS=250
BROWSER_MAX_EVENTS=200
BROWSER_MAX_SCREENSHOT_BYTES=8000000
BROWSER_MAX_PAGE_PIXELS=20000000
BROWSER_MAX_CONCURRENT_EXECUTIONS=2

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
