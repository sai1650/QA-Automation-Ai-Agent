APP_NAME=Autonomous QA Intelligence Platform
APP_VERSION=0.1.0
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database: Railway provides MYSQL_URL or individual MYSQLHOST, MYSQLPORT, etc.
# If using Railway MySQL, you can set DATABASE_URL=${{MySQL.MYSQL_URL}}
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=AI_AGENT
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Frontend domain for CORS (e.g. https://your-project.vercel.app)
CORS_ORIGINS=https://your-frontend.vercel.app

# Ollama LLM endpoint
# If hosting Ollama on RunPod, a VPS, or a cloud container:
OLLAMA_BASE_URL=http://your-ollama-host:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120

# RAG & ChromaDB
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_COLLECTION_NAME=qa_historical_knowledge

# Headless browser inspection
BROWSER_HEADLESS=true
ARTIFACT_DIR=/tmp/artifacts
